{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev --parallel",
    "build": "nx run-many -t build",
    "clean": "pnpm -r --parallel run clean && node -e \"['dist','.nx','node_modules'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/node": "^24.13.3",
    "eslint": "^10.15.0",
    "nx": "23.1.0",
    "prettier": "^3.10.1",
    "tslib": "^2.9.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ],
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "^3.0.0"
        }
      }
    }
  }
}
