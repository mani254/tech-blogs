{
  "name": "@org/content-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "node -e \"['dist','node_modules'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import @swc-node/register/esm-register --test tests/*.test.tsx"
  },
  "dependencies": {
    "@org/shared": "workspace:*",
    "@org/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.7.3"
  }
}

