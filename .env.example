# Application
NODE_ENV=development
PORT=5000
API_PREFIX=api
API_DEFAULT_VERSION=1
CORS_ORIGIN=http://localhost:1234,http://localhost:4200,http://localhost:3001,http://localhost:3000,http://localhost:5173

# MongoDB (via @org/dal)
MONGODB_URI=mongodb://localhost:27017/chat-app
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Better Auth & OAuth
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_API_KEY=your_better_auth_api_key_here
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP / Brevo Mail Integration
SIB_API_KEY=your_brevo_api_key_here
SMTP_USER=your_smtp_user_here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Redis (optional — leave empty until Redis is configured)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_r2_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=tech-blogs-assets
CLOUDFLARE_R2_PUBLIC_URL=https://assets.techblogs.dev
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
